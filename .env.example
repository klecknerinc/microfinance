# Public browser configuration for the production deployment
VITE_INSFORGE_URL=https://your-appkey.us-east.insforge.app
VITE_INSFORGE_ANON_KEY=replace-with-insforge-anon-key

# Server-only InsForge secrets. Never prefix these with VITE_.
# INSFORGE_BASE_URL is supplied automatically by InsForge.
# API_KEY is a reserved project secret supplied automatically by InsForge.
# APP_ORIGIN=https://your-production-site.example
